# The address people open Aurai at, no trailing slash. Sign-in links are built from it.
# A public https:// address also lets OpenRouter tell Aurai when a video is ready, and is
# needed for Edit Video.
SITE_URL=http://localhost:3000

# Where the SQLite database and the photos and videos live. In Docker it is /app/data.
# DATA_DIR=data

# Both required in production, and they must differ. Generate each with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
ENCRYPTION_KEY=

# SMTP delivery. Without a host, sign-in emails are printed to the terminal instead.
# Leave USER and PASSWORD empty for a relay that authenticates by IP.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=Aurai <aurai@example.com>

# Who may create an account. Signup is open by default.
SIGNUP_ENABLED=true
# Comma-separated, e.g. example.com,example.org. Empty means any domain.
ALLOWED_EMAIL_DOMAINS=
# 0 means unlimited.
MAX_USERS=0

# Per-user storage quota for uploads and results, in MB.
USER_QUOTA_MB=2048

# Cloudflare Turnstile on the sign-in form (recommended with open signup). Both or neither.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Development: fake OpenRouter responses so nothing is billed.
OPENROUTER_MOCK=false
